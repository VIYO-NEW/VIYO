# ============================================================
# VIYO Staging Environment Variables
# Authority: Doc1 lines 9690-9700, Doc11 line 43, T90 / SEC-10 Builder Execution Brief
#
# Use only staging service credentials. Do not paste production database,
# Supabase, Render, Vercel, Inngest, Redis, R2, Stripe, or vault values here.
# This file is intentionally placeholder-only and must not contain secrets.
# ============================================================

# --- Supabase staging project ---
SUPABASE_URL=https://[staging-project-ref].supabase.co
SUPABASE_ANON_KEY=${STAGING_SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${STAGING_SUPABASE_SERVICE_ROLE_KEY}
DATABASE_URL=${STAGING_DATABASE_URL}
DIRECT_URL=${STAGING_DIRECT_URL}

# --- Auth ---
SUPABASE_JWT_SECRET=${STAGING_SUPABASE_JWT_SECRET}

# --- Credential Vault ---
VIYO_VAULT_KEY=${STAGING_VIYO_VAULT_KEY}
VIYO_VAULT_KEY_PREVIOUS=

# --- Stripe Billing (test-mode only) ---
STRIPE_SECRET_KEY=${STAGING_STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STAGING_STRIPE_WEBHOOK_SECRET}

# --- Inngest Event Orchestration (staging app/key only) ---
INNGEST_EVENT_KEY=${STAGING_INNGEST_EVENT_KEY}
INNGEST_SIGNING_KEY=${STAGING_INNGEST_SIGNING_KEY}

# --- Image Generation APIs ---
GOOGLE_AI_API_KEY=${STAGING_GOOGLE_AI_API_KEY}
IDEOGRAM_API_KEY=${STAGING_IDEOGRAM_API_KEY}

# --- Cloudflare R2 (staging bucket only) ---
R2_ACCOUNT_ID=${STAGING_R2_ACCOUNT_ID}
R2_ACCESS_KEY_ID=${STAGING_R2_ACCESS_KEY_ID}
R2_SECRET_ACCESS_KEY=${STAGING_R2_SECRET_ACCESS_KEY}
R2_BUCKET_NAME=viyo-assets-staging

# --- Upstash Redis (staging database only) ---
UPSTASH_REDIS_REST_URL=${STAGING_UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_REST_TOKEN=${STAGING_UPSTASH_REDIS_REST_TOKEN}

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=${STAGING_OTEL_EXPORTER_OTLP_ENDPOINT}
OTEL_SERVICE_NAME=viyo-worker-staging

# --- Sentry Error Monitoring ---
SENTRY_DSN_WORKER=${STAGING_SENTRY_DSN_WORKER}
SENTRY_AUTH_TOKEN=${STAGING_SENTRY_AUTH_TOKEN}
SENTRY_ORG=viyo
SENTRY_PROJECT_WEB=viyo-web
SENTRY_PROJECT_ADMIN=viyo-admin
SENTRY_RELEASE=

# --- Frontend (Vite public vars; configure in Vercel Staging environment) ---
VITE_SUPABASE_URL=https://[staging-project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=${STAGING_SUPABASE_ANON_KEY}
VITE_APP_URL=https://app.staging.viyo.new
VITE_API_URL=https://api.staging.viyo.new
VITE_SENTRY_DSN_WEB=${STAGING_VITE_SENTRY_DSN_WEB}
VITE_SENTRY_DSN_ADMIN=${STAGING_VITE_SENTRY_DSN_ADMIN}

# --- Worker / Deployment ---
NODE_ENV=production
PORT=3001

# --- Synthetic-only staging seed guard ---
VIYO_SEED_TARGET=staging
VIYO_ALLOW_STAGING_SEED=true
VIYO_STAGING_WORKSPACE_COUNT=3
VIYO_STAGING_USERS_PER_WORKSPACE=2
