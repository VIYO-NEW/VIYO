# ============================================================
# VIYO Environment Variables
# Copy to .env and fill in values for your environment
# ============================================================

# --- Supabase (T2/T3) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Auth (T3) ---
SUPABASE_JWT_SECRET=

# --- Credential Vault (T8) ---
# 64 hex chars = 32 bytes. Generate: openssl rand -hex 32
VIYO_VAULT_KEY=
# Set during key rotation — the OLD key so decrypt() can handle both
VIYO_VAULT_KEY_PREVIOUS=

# --- Stripe Billing (T9) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Inngest Event Orchestration (T5) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Image Generation APIs (Phase 2+) ---
GOOGLE_AI_API_KEY=
IDEOGRAM_API_KEY=

# --- Cloudflare R2 (P0-14) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=viyo-assets

# --- Upstash Redis (P0-15) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OpenTelemetry (T5) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=viyo-worker

# --- Frontend (Vite public vars) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# --- Worker / Deployment ---
NODE_ENV=development
PORT=3001
